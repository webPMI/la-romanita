---
// Formulario para crear o editar categoría
const { categoria = null } = Astro.props;
---
<form class="categoria-form">
  <label>
    Nombre:
    <input type="text" name="nombre" value={categoria?.nombre || ''} required />
  </label>
  <label>
    Descripción:
    <input type="text" name="descripcion" value={categoria?.descripcion || ''} />
  </label>
  <button type="submit">{categoria ? 'Actualizar' : 'Crear'} Categoría</button>
</form>
