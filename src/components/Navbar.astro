---
<header class="navbar-wrapper">
  <div class="container navbar">
    <a href="/" class="logo">
      <span class="logo-la">La</span><span class="logo-romanita">Romanita</span>
    </a>
    
    <nav class="nav-links">
      <a href="/" class="nav-link">Inicio</a>
      <a href="/menu" class="nav-link">Menú</a>
      <a href="/login" class="nav-link">Mi Cuenta</a>
      <!-- En un futuro, este enlace de admin se mostrará condicionalmente si el usuario es Admin -->
      <a href="/admin/dashboard" class="nav-link admin-link">Admin</a>
      
      <a href="/menu" class="btn-primary btn-sm">Hacer Pedido</a>
    </nav>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1rem 0;
  }
  
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  
  .logo-la {
    color: var(--text-main);
  }
  
  .logo-romanita {
    color: var(--primary);
  }
  
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  
  .nav-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-muted);
    position: relative;
  }
  
  .nav-link:hover {
    color: var(--text-main);
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--primary);
    transition: width 0.3s ease;
  }
  
  .nav-link:hover::after {
    width: 100%;
  }

  .admin-link {
    color: var(--secondary);
  }
  .admin-link:hover {
    color: #fcd34d;
  }
  .admin-link::after {
    background-color: var(--secondary);
  }
  
  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none; /* In a real app, we'd add a hamburger menu */
    }
  }
</style>
