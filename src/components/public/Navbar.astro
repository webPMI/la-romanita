---
const base = import.meta.env.BASE_URL;
---
<header class="navbar-wrapper">
  <div class="container navbar">
    <a href={base} class="logo" id="nav-logo">
      <span class="logo-la">La</span><span class="logo-romanita">Romanita</span>
    </a>
    
    <!-- Botón Hamburguesa para Móvil -->
    <button class="hamburger-menu" id="menuToggle" aria-label="Abrir menú de navegación" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    
    <nav class="nav-links" id="navLinks">
      <a href={base} class="nav-link" id="nav-link-home">Inicio</a>
      <a href={`${base}menu`} class="nav-link" id="nav-link-menu">Menú</a>
      <a href={`${base}login`} class="nav-link" id="nav-link-account">Mi Cuenta</a>
      <a href={`${base}admin/dashboard`} class="nav-link admin-link hide" id="nav-link-admin">Admin</a>
      
      <!-- Contenedor dinámico del estado del usuario -->
      <div class="user-status-container hide" id="user-status">
        <span class="user-greeting" id="user-greeting">Hola, Demo</span>
        <span class="customer-mode-badge hide" id="customer-mode-badge">Modo Cliente (Admin)</span>
        <button class="btn-secondary btn-sm" id="btn-logout">Cerrar Sesión</button>
      </div>

      <a href={`${base}menu`} class="btn-primary btn-sm">Hacer Pedido</a>
    </nav>
  </div>
</header>

<script>
  function updateNavbar() {
    const userJson = localStorage.getItem('currentUser');
    const navAccount = document.getElementById('nav-account') || document.getElementById('nav-link-account');
    const navAdmin = document.getElementById('nav-admin') || document.getElementById('nav-link-admin');
    const userStatus = document.getElementById('user-status');
    const userGreeting = document.getElementById('user-greeting');
    const customerModeBadge = document.getElementById('customer-mode-badge');
    const basePath = window.location.pathname.startsWith('/la-romanita') ? '/la-romanita' : '';

    if (userJson) {
      try {
        const user = JSON.parse(userJson);
        if (navAccount) {
          navAccount.setAttribute('href', user.role === 'admin' ? `${basePath}/admin/dashboard` : `${basePath}/user/dashboard`);
          navAccount.classList.remove('hide');
        }
        if (userStatus) userStatus.classList.remove('hide');
        if (userGreeting) userGreeting.textContent = `Hola, ${user.name.split(' ')[0]}`;
        
        if (user.role === 'admin') {
          if (navAdmin) navAdmin.classList.remove('hide');

          const isAdminSection = window.location.pathname.startsWith(`${basePath}/admin`);
          if (customerModeBadge) {
            customerModeBadge.classList.toggle('hide', isAdminSection);
          }
        } else {
          if (navAdmin) navAdmin.classList.add('hide');
          if (customerModeBadge) customerModeBadge.classList.add('hide');
        }
      } catch (e) {
        console.error('Error parsing user session', e);
      }
    } else {
      if (navAccount) {
        navAccount.setAttribute('href', `${basePath}/login`);
        navAccount.classList.remove('hide');
      }
      if (userStatus) userStatus.classList.add('hide');
      if (navAdmin) navAdmin.classList.add('hide');
      if (customerModeBadge) customerModeBadge.classList.add('hide');
    }
  }

  // Ejecutar al cargar la página
  document.addEventListener('DOMContentLoaded', () => {
    updateNavbar();

    // Escuchar cambios de autenticación del login
    window.addEventListener('auth-changed', updateNavbar);

    // Lógica para cerrar sesión
    const btnLogout = document.getElementById('btn-logout');
    if (btnLogout) {
      btnLogout.addEventListener('click', async () => {
        const base = window.location.pathname.startsWith('/la-romanita') ? '/la-romanita' : '';
        
        try {
          // Limpiar cookies de sesión en el servidor
          await fetch(`${base}/api/auth/logout`, { method: 'POST' });
        } catch (e) {
          console.error('Error al expirar sesión en backend:', e);
        }
        
        localStorage.removeItem('currentUser');
        updateNavbar();
        
        // Redirigir a login
        window.location.href = `${base}/login`;
      });
    }

    // --- Lógica del Menú Hamburguesa en Móvil ---
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');

    if (menuToggle && navLinks) {
      menuToggle.addEventListener('click', () => {
        const isActive = menuToggle.classList.toggle('active');
        navLinks.classList.toggle('active');
        menuToggle.setAttribute('aria-expanded', isActive.toString());
      });

      // Cerrar menú al hacer clic en cualquier enlace
      const links = navLinks.querySelectorAll('a, button');
      links.forEach(link => {
        link.addEventListener('click', () => {
          menuToggle.classList.remove('active');
          navLinks.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: var(--border);
    padding: var(--space-sm) 0;
  }
  
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    z-index: 160;
  }
  
  .logo-la {
    color: var(--color-text-main);
  }
  
  .logo-romanita {
    color: var(--color-primary);
  }
  
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  
  .nav-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    position: relative;
  }
  
  .nav-link:hover {
    color: var(--color-text-main);
  }
  
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-primary);
    transition: width 0.3s ease;
  }
  
  .nav-link:hover::after {
    width: 100%;
  }

  .admin-link {
    color: var(--color-secondary);
  }
  .admin-link:hover {
    color: var(--color-primary);
  }
  .admin-link::after {
    background-color: var(--color-primary);
  }
  
  .btn-sm {
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.9rem;
  }

  /* User Status styles */
  .user-status-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-greeting {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .customer-mode-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(188, 26, 34, 0.1);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }

  /* --- Botón Hamburguesa Estilos --- */
  .hamburger-menu {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 160;
    padding: 0;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-main);
    transition: all 0.3s ease;
  }

  /* Transformaciones a cruz (X) */
  .hamburger-menu.active .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .hamburger-menu.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .hamburger-menu.active .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Responsivo para móviles */
  @media (max-width: 768px) {
    .hamburger-menu {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      width: 100%;
      height: 100vh;
      background: var(--color-glass);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 2.5rem;
      z-index: 150;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      padding: 3rem 1.5rem;
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-link {
      font-size: 1.3rem;
    }

    .user-status-container {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .user-greeting {
      font-size: 1.2rem;
    }
  }
</style>
