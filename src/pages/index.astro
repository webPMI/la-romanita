---
import Features from '../components/public/Features.astro';
import Hero from '../components/public/Hero.astro';
import Layout from '../layouts/Layout.astro';
import { getSupabaseServerClient, getCachedData } from '../lib/supabase';

const client = getSupabaseServerClient();

// 1. Obtener ofertas destacadas utilizando el helper de caché
const offers = await getCachedData('home_offers', async () => {
  const { data } = await client
    .from('products')
    .select('*')
    .eq('is_active', true)
    .eq('is_offer', true)
    .limit(3);
  return data || [];
});

// 2. Obtener horarios de la tienda utilizando el helper de caché
const horarios = await getCachedData('home_horarios', async () => {
  const { data } = await client
    .from('horarios')
    .select('dia_semana, hora_apertura, hora_cierre')
    .eq('is_active', true);
  return data || [];
});

// 3. Obtener ubicación/dirección de contacto utilizando el helper de caché
const direccion = await getCachedData('home_direccion', async () => {
  const { data } = await client
    .from('contacto')
    .select('valor')
    .eq('tipo', 'direccion')
    .maybeSingle();
  return data?.valor || 'Carrer de Jaume Balmes, 59, Nord, 07004 Palma, Illes Balears';
});
---

<Layout title="Inicio">
  <Hero />
  
  <Features />

  <!-- Sección: Ofertas Destacadas (Menú Destacado) -->
  {offers && offers.length > 0 && (
    <section class="featured-offers container">
      <div class="section-title text-center">
        <h2>🔥 Ofertas Destacadas</h2>
        <p>Aprovecha nuestras promociones especiales preparadas para hoy.</p>
      </div>
      <div class="offers-grid">
        {offers.map((item) => (
          <div class="offer-card glass-panel">
            <div class="offer-badge-label">OFERTA</div>
            {item.image_url ? (
              <img src={item.image_url} alt={item.name} class="offer-image" />
            ) : (
              <div class="offer-image-placeholder">🍝</div>
            )}
            <div class="offer-details">
              <h3>{item.name}</h3>
              <p>{item.description || 'Elaboración artesanal fresca diariamente.'}</p>
              <div class="offer-pricing">
                <span class="price-old">€{(parseFloat(item.price_minorista) * 1.2).toFixed(2)}</span>
                <span class="price-new">€{parseFloat(item.price_minorista).toFixed(2)}</span>
              </div>
              <a href="/menu" class="btn-primary btn-sm full-width text-center">Añadir al Pedido</a>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Sección: Horarios y Ubicación (Dinámicos) -->
  <section class="location-hours container">
    <div class="grid-container">
      <div class="hours-card glass-panel">
        <h2>⏰ Horario de Apertura</h2>
        <p class="section-desc">Visítanos o encarga tu pasta para recoger en los siguientes horarios:</p>
        <div class="hours-list">
          {horarios && horarios.length > 0 ? (
            horarios.map((h) => (
              <div class="hours-row">
                <span class="day">{h.dia_semana}</span>
                <span class="time">{h.hora_apertura.slice(0, 5)} a {h.hora_cierre.slice(0, 5)}</span>
              </div>
            ))
          ) : (
            <>
              <div class="hours-row">
                <span class="day">Lunes a Sábado</span>
                <span class="time">09:00 a 20:00</span>
              </div>
              <div class="hours-row">
                <span class="day">Domingos</span>
                <span class="time">09:00 a 15:00</span>
              </div>
            </>
          )}
        </div>
      </div>

      <div class="map-card glass-panel">
        <h2>📍 Dónde Encontrarnos</h2>
        <p class="address-text"><strong>Dirección:</strong> {direccion}</p>
        <div class="map-iframe-container">
          <!-- Mapa interactivo de Google Maps enfocado en Carrer de Jaume Balmes, 59, Palma -->
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3074.887913079815!2d2.6517173766023347!3d39.58474240533504!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12979251ab66e4a9%3A0xe54e61b7fcf72c1c!2sCarrer%20de%20Jaume%20Balmes%2C%2059%2C%20Nord%2C%2007004%20Palma%2C%20Illes%20Balears!5e0!3m2!1ses!2ses!4v1716982000000!5m2!1ses!2ses" 
            width="100%" 
            height="220" 
            style="border:0; border-radius: 8px;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección: Preguntas Frecuentes (FAQs) y Testimonios -->
  <section class="faqs-testimonials container">
    <div class="section-title text-center">
      <h2>🗣️ Lo que dicen nuestros clientes</h2>
      <p>Nuestra prioridad es tu satisfacción. Aquí tienes opiniones y dudas frecuentes.</p>
    </div>
    
    <div class="grid-container">
      <!-- Testimonios -->
      <div class="testimonials-block">
        <div class="testimonial-card glass-panel">
          <p class="quote">"La mejor pasta fresca de Palma, sin duda alguna. Los sorrentinos son espectaculares y las empanadas son de carne de verdad. Super recomendable."</p>
          <span class="author">⭐ Mariana G. (Cliente desde hace 10 años)</span>
        </div>
        <div class="testimonial-card glass-panel">
          <p class="quote">"Negocio familiar italo-argentino impecable. Calidad excelente a precios razonables. Siempre compramos aquí para los almuerzos del domingo."</p>
          <span class="author">⭐ Pedro S. (Restaurador local)</span>
        </div>
      </div>

      <!-- Acordeón de FAQs -->
      <div class="faqs-block glass-panel">
        <h2>❓ Preguntas Frecuentes</h2>
        <div class="faq-item">
          <details>
            <summary>¿Tienen opciones para intolerancias alimentarias?</summary>
            <p>Elaboramos nuestras pastas tradicionales con sémola de trigo duro. Consulta a nuestro personal por opciones especiales o salsas libres de ciertos alérgenos.</p>
          </details>
        </div>
        <div class="faq-item">
          <details>
            <summary>¿Cómo hago un pedido para eventos?</summary>
            <p>Puedes llamarnos o escribirnos por WhatsApp con 24-48 horas de antelación para pedidos grandes, cáterin de empanadas, matambres o bandejas de pastas.</p>
          </details>
        </div>
        <div class="faq-item">
          <details>
            <summary>¿Disponen de entrega a domicilio?</summary>
            <p>Actualmente trabajamos bajo la modalidad de encargo previo y recogida en tienda (Take Away) para garantizar la máxima frescura de la pasta recién hecha.</p>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- Sección: Pedido Rápido / Contacto -->
  <section class="quick-contact container">
    <div class="contact-card glass-panel">
      <div class="contact-info-side">
        <h2>✉️ ¿Tienes dudas o sugerencias?</h2>
        <p>Escríbenos directamente y te responderemos en la mayor brevedad posible.</p>
        <div class="contact-shortcuts">
          <a href="https://wa.me/34643384775" class="btn-secondary btn-sm">Chatear por WhatsApp</a>
        </div>
      </div>
      <form class="contact-form" id="homeContactForm">
        <div class="form-group">
          <label for="cname">Nombre</label>
          <input type="text" id="cname" placeholder="Tu nombre" required />
        </div>
        <div class="form-group">
          <label for="cemail">Correo Electrónico</label>
          <input type="email" id="cemail" placeholder="tu@correo.com" required />
        </div>
        <div class="form-group">
          <label for="cmessage">Mensaje</label>
          <textarea id="cmessage" rows="3" placeholder="¿En qué te podemos ayudar?" required></textarea>
        </div>
        <button type="submit" class="btn-primary btn-sm">Enviar Mensaje</button>
      </form>
    </div>
  </section>
</Layout>

<script is:inline>
  // Manejo de feedback interactivo del formulario de contacto
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('homeContactForm');
    if (form instanceof HTMLFormElement) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('¡Gracias por tu mensaje! Nos pondremos en contacto contigo pronto.');
        form.reset();
      });
    }
  });
</script>

<style>
  .section-title {
    margin-bottom: 3rem;
  }
  .section-title h2 {
    font-size: 2.2rem;
    color: var(--color-secondary);
  }
  .section-title p {
    color: var(--color-text-muted);
  }

  /* Ofertas Destacadas */
  .featured-offers {
    padding: 4rem 0;
  }
  .offers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  .offer-card {
    padding: 1.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease;
  }
  .offer-card:hover {
    transform: translateY(-4px);
  }
  .offer-badge-label {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    z-index: 10;
  }
  .offer-image {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  .offer-image-placeholder {
    width: 100%;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    background: rgba(188, 26, 34, 0.04);
    border-radius: 8px;
    margin-bottom: 1rem;
  }
  .offer-details h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }
  .offer-details p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }
  .offer-pricing {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .price-old {
    color: var(--color-text-muted);
    text-decoration: line-through;
    font-size: 1rem;
  }
  .price-new {
    color: var(--color-primary);
    font-weight: 800;
    font-size: 1.4rem;
  }
  .full-width {
    width: 100%;
  }

  /* Horarios y Ubicación */
  .location-hours {
    padding: 4rem 0;
  }
  .grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: 1fr;
    }
  }
  .hours-card, .map-card {
    padding: 2.5rem;
    height: 100%;
  }
  .hours-card h2, .map-card h2 {
    color: var(--color-secondary);
    margin-bottom: 1rem;
  }
  .section-desc, .address-text {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hours-row {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--color-border);
    font-size: 1rem;
  }
  .hours-row .day {
    font-weight: 600;
    color: var(--color-text-main);
  }
  .hours-row .time {
    color: var(--color-primary);
    font-weight: 800;
  }
  .map-iframe-container {
    overflow: hidden;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.05);
  }

  /* Testimonios y FAQs */
  .faqs-testimonials {
    padding: 4rem 0;
  }
  .testimonials-block {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .testimonial-card {
    padding: 2rem;
  }
  .testimonial-card .quote {
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-main);
    margin-bottom: 1rem;
  }
  .testimonial-card .author {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .faqs-block {
    padding: 2.5rem;
  }
  .faqs-block h2 {
    margin-bottom: 1.5rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-item summary {
    font-weight: 600;
    cursor: pointer;
    color: var(--color-text-main);
    outline: none;
  }
  .faq-item summary:hover {
    color: var(--color-primary);
  }
  .faq-item p {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Contacto Rápido */
  .quick-contact {
    padding: 4rem 0;
  }
  .quick-contact .contact-card {
    padding: 3rem;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .quick-contact .contact-card {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 1.5rem;
    }
  }
  .contact-info-side h2 {
    font-size: 1.8rem;
    color: var(--color-secondary);
  }
  .contact-info-side p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .contact-form .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .contact-form label {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .contact-form input, .contact-form textarea {
    padding: 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.6);
    font-family: var(--font-sans);
  }
  .contact-form input:focus, .contact-form textarea:focus {
    border-color: var(--color-primary);
    outline: none;
    background: white;
  }
</style>
