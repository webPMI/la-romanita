---
import Layout from '../../layouts/Layout.astro';

// Datos simulados para el admin
const recentOrders = [
  { id: "#0012", user: "Carlos G.", items: "2x Sorrentinos, 4x Empanadas", status: "Pendiente", total: "15.00" },
  { id: "#0011", user: "Maria F.", items: "1x Raviolis, 1x Canelones", status: "Listo", total: "9.50" },
];
---

<Layout title="Panel de Administración">
  <div class="admin-layout container animate-fade-in">
    <aside class="admin-sidebar glass-panel">
      <h2>Admin POS</h2>
      <nav class="admin-nav">
        <a href="#" class="active">Pedidos Activos</a>
        <a href="#">Catálogo de Productos</a>
        <a href="#">Usuarios</a>
        <a href="#">Configuración</a>
      </nav>
    </aside>

    <div class="admin-content">
      <header class="admin-header">
        <h1>Resumen de Hoy</h1>
        <div class="stats-grid">
          <div class="stat-card glass-panel">
            <h3>Pedidos Hoy</h3>
            <span class="stat-value">12</span>
          </div>
          <div class="stat-card glass-panel">
            <h3>Ingresos</h3>
            <span class="stat-value">€145.50</span>
          </div>
        </div>
      </header>

      <section class="orders-section">
        <h2>Pedidos Recientes</h2>
        <div class="orders-list">
          {recentOrders.map((order) => (
            <div class="order-card glass-panel">
              <div class="order-header">
                <span class="order-id">{order.id}</span>
                <span class={`status badge-${order.status.toLowerCase()}`}>{order.status}</span>
              </div>
              <p><strong>Cliente:</strong> {order.user}</p>
              <p class="order-items">{order.items}</p>
              <div class="order-footer">
                <span class="order-total">€{order.total}</span>
                <div class="order-actions">
                  <button class="btn-secondary btn-sm">Ver</button>
                  <button class="btn-primary btn-sm">Avanzar Estado</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .admin-layout {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    padding: 2rem 0;
  }

  .admin-sidebar {
    padding: 2rem 1.5rem;
    height: calc(100vh - 120px);
    position: sticky;
    top: 100px;
  }

  .admin-sidebar h2 {
    color: var(--secondary);
    margin-bottom: 2rem;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .admin-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .admin-nav a {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    color: var(--text-muted);
    transition: all 0.2s;
  }

  .admin-nav a:hover, .admin-nav a.active {
    background: rgba(255,255,255,0.05);
    color: var(--text-main);
  }

  .admin-header h1 {
    margin-bottom: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .stat-card {
    padding: 1.5rem;
  }

  .stat-card h3 {
    font-size: 1rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
  }

  .stat-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
  }

  .orders-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .order-card {
    padding: 1.5rem;
  }

  .order-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    padding-bottom: 0.5rem;
  }

  .order-id {
    font-weight: bold;
    font-size: 1.1rem;
  }

  .status {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .badge-pendiente {
    background: rgba(217, 119, 6, 0.2);
    color: var(--secondary);
  }

  .badge-listo {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
  }

  .order-items {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .order-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .order-total {
    font-size: 1.2rem;
    font-weight: bold;
  }

  .order-actions {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .admin-layout {
      grid-template-columns: 1fr;
    }
    .admin-sidebar {
      height: auto;
      position: relative;
      top: 0;
    }
  }
</style>
