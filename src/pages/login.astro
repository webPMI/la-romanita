---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Iniciar Sesión">
  <div class="login-page-wrapper">
    <div class="glow glow-primary"></div>
    <div class="glow glow-secondary"></div>

    <div class="container login-container animate-fade-in">
      <div class="login-card glass-panel">
        <div class="login-header">
          <div class="logo-badge">🍝</div>
          <h2>Bienvenido de nuevo</h2>
          <p>Inicia sesión para realizar pedidos o acceder a tu cuenta.</p>
        </div>

        <form class="login-form" id="loginForm" autocomplete="on">
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <div class="input-wrapper">
              <span class="input-icon">✉️</span>
              <input type="email" id="email" placeholder="tu@email.com" required autocomplete="email" />
            </div>
          </div>

          <div class="form-group">
            <label for="password">Contraseña</label>
            <div class="input-wrapper">
              <span class="input-icon">🔒</span>
              <input type="password" id="password" placeholder="••••••••" required autocomplete="current-password" />
              <button
                type="button"
                id="togglePassword"
                class="toggle-password"
                aria-label="Mostrar contraseña"
                aria-pressed="false"
              >👁️</button>
            </div>
          </div>

          <div class="remember-row">
            <label class="remember-label" for="rememberAccount">
              <input type="checkbox" id="rememberAccount" />
              <span>Recordar cuenta en este dispositivo</span>
            </label>
          </div>

          <button type="submit" class="btn-primary full-width" id="submitBtn">
            <span class="btn-text">Iniciar Sesión</span>
            <span class="spinner hide"></span>
          </button>

          <div class="auth-divider" aria-hidden="true">
            <span>o</span>
          </div>

          <button type="button" class="btn-google" id="googleLoginBtn" disabled title="Disponible próximamente">
            <span class="google-icon">G</span>
            <span>Continuar con Google (Próximamente)</span>
          </button>
        </form>

        <div class="login-footer">
          <p>¿No tienes cuenta? <a href={`${base}register`} class="highlight">Regístrate</a></p>
        </div>
      </div>
    </div>
  </div>

  <div id="toastContainer" class="toast-container"></div>
</Layout>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const loginForm = document.getElementById('loginForm');
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');
  const rememberAccountInput = document.getElementById('rememberAccount');
  const submitBtn = document.getElementById('submitBtn');
  const googleLoginBtn = document.getElementById('googleLoginBtn');
  const togglePasswordBtn = document.getElementById('togglePassword');
  const btnText = submitBtn ? submitBtn.querySelector('.btn-text') : null;
  const spinner = submitBtn ? submitBtn.querySelector('.spinner') : null;
  const toastContainer = document.getElementById('toastContainer');
  const loginCard = document.querySelector('.login-card');

  // Dynamic base path determination
  const base = window.location.pathname.startsWith('/la-romanita') ? '/la-romanita' : '';

  // Filter error messages for user-friendly output
  function filterErrorMessage(msg) {
    if (!msg) return 'Ocurrió un error inesperado. Por favor, inténtalo de nuevo.';
    const rawMsg = msg.toLowerCase();
    
    if (rawMsg.includes('invalid login credentials') || rawMsg.includes('invalid claim') || rawMsg.includes('invalid client_id')) {
      return 'El correo electrónico o la contraseña no son correctos. Por favor, compruébalos.';
    }
    if (rawMsg.includes('email not confirmed') || rawMsg.includes('email_not_confirmed')) {
      return 'Tu correo electrónico aún no ha sido verificado. Por favor, revisa tu bandeja de entrada.';
    }
    if (rawMsg.includes('user already exists') || rawMsg.includes('user_already_exists') || rawMsg.includes('already registered')) {
      return 'Ya existe una cuenta registrada con este correo electrónico. Intenta iniciar sesión.';
    }
    if (rawMsg.includes('password should be') || rawMsg.includes('password is too short') || rawMsg.includes('weak password')) {
      return 'La contraseña es demasiado débil o corta. Debe tener al menos 6 caracteres.';
    }
    if (rawMsg.includes('signup disabled') || rawMsg.includes('signups_not_allowed')) {
      return 'El registro de nuevos usuarios está temporalmente deshabilitado.';
    }
    if (rawMsg.includes('network error') || rawMsg.includes('failed to fetch') || rawMsg.includes('network_error') || rawMsg.includes('connect')) {
      return 'No se pudo conectar con el servidor. Por favor, comprueba tu conexión a Internet.';
    }
    if (rawMsg.includes('rate limit') || rawMsg.includes('too many requests') || rawMsg.includes('over_query_limit')) {
      return 'Has realizado demasiados intentos en poco tiempo. Por favor, espera unos minutos antes de volver a intentarlo.';
    }
    if (rawMsg.includes('captcha') || rawMsg.includes('bot')) {
      return 'Error de verificación de seguridad (CAPTCHA). Por favor, inténtalo de nuevo.';
    }
    if (rawMsg.includes('invalid email') || rawMsg.includes('email address is invalid')) {
      return 'Por favor, introduce un correo electrónico válido.';
    }
    if (rawMsg.includes('exception') || rawMsg.includes('database') || rawMsg.includes('query') || rawMsg.includes('sql') || rawMsg.includes('null value') || rawMsg.includes('column') || rawMsg.includes('foreign key')) {
      return 'Ocurrió un problema técnico al procesar la solicitud. Por favor, contacta con soporte.';
    }
    return msg;
  }

  // Handle toast alerts
  function showToast(message, type = 'success') {
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.innerHTML = `
      <span class="toast-icon">${type === 'success' ? '✅' : '❌'}</span>
      <span class="toast-message">${message}</span>
    `;
    toastContainer.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.add('show');
    });
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 300);
    }, 4000);
  }

  const urlError = new URLSearchParams(window.location.search).get('error');
  if (urlError) {
    showToast(filterErrorMessage(decodeURIComponent(urlError)), 'error');
  }

  const rememberedEmail = localStorage.getItem('rememberedEmail');
  if (rememberedEmail && emailInput && rememberAccountInput) {
    emailInput.value = rememberedEmail;
    rememberAccountInput.checked = true;
  }

  if (togglePasswordBtn && passwordInput) {
    togglePasswordBtn.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      togglePasswordBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
      togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
      togglePasswordBtn.textContent = isPassword ? '🙈' : '👁️';
    });
  }

  if (googleLoginBtn) {
    googleLoginBtn.addEventListener('click', () => {
      showToast('Login con Google estará disponible próximamente.', 'error');
    });
  }

  if (loginForm) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const email = emailInput?.value.trim() || '';
      const password = passwordInput?.value || '';
      const remember = !!rememberAccountInput?.checked;

      // Seguridad: solo persistimos el email, nunca contraseña ni tokens.
      if (remember && email) {
        localStorage.setItem('rememberedEmail', email);
      } else {
        localStorage.removeItem('rememberedEmail');
      }

      // Loading state
      if (submitBtn) submitBtn.disabled = true;
      if (emailInput) emailInput.disabled = true;
      if (passwordInput) passwordInput.disabled = true;
      if (btnText) btnText.classList.add('hide');
      if (spinner) spinner.classList.remove('hide');

      // Realizar petición real de inicio de sesión a la API del servidor
      fetch(`${base}/api/auth/login`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ email, password, remember })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success && data.user) {
          showToast(`¡Bienvenido de nuevo, ${data.user.name}! Accediendo...`, 'success');
          localStorage.setItem('currentUser', JSON.stringify({
            email: data.user.email,
            name: data.user.name,
            role: data.user.role,
            client_type: data.user.client_type
          }));
          window.dispatchEvent(new Event('auth-changed'));
          setTimeout(() => {
            if (data.user.role === 'admin') {
              window.location.href = `${base}/admin/dashboard`;
            } else {
              window.location.href = `${base}/menu`;
            }
          }, 1200);
        } else {
          showToast(filterErrorMessage(data.error || 'Correo electrónico o contraseña incorrectos.'), 'error');
          if (loginCard) loginCard.classList.add('shake-error');
          setTimeout(() => loginCard && loginCard.classList.remove('shake-error'), 500);
          if (submitBtn) submitBtn.disabled = false;
          if (emailInput) emailInput.disabled = false;
          if (passwordInput) passwordInput.disabled = false;
          if (btnText) btnText.classList.remove('hide');
          if (spinner) spinner.classList.add('hide');
        }
      })
      .catch(err => {
        console.error('Error durante el inicio de sesión:', err);
        showToast(filterErrorMessage(err.message || 'network_error'), 'error');
        if (loginCard) loginCard.classList.add('shake-error');
        setTimeout(() => loginCard && loginCard.classList.remove('shake-error'), 500);
        if (submitBtn) submitBtn.disabled = false;
        if (emailInput) emailInput.disabled = false;
        if (passwordInput) passwordInput.disabled = false;
        if (btnText) btnText.classList.remove('hide');
        if (spinner) spinner.classList.add('hide');
      });
    });
  }
});
</script>

<style>
  .login-page-wrapper {
    position: relative;
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    padding: 3rem 1.5rem;
  }

  /* Abstract Background Glows */
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.12;
    z-index: 1;
    pointer-events: none;
  }

  .glow-primary {
    top: 20%;
    left: 20%;
    width: 450px;
    height: 450px;
    background: var(--primary);
  }

  .glow-secondary {
    bottom: 20%;
    right: 20%;
    width: 450px;
    height: 450px;
    background: var(--secondary);
  }

  .login-container {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    max-width: 900px;
    width: 100%;
    align-items: start;
  }

  .login-card {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgba(11, 19, 43, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .login-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(11, 19, 43, 0.08);
  }

  .login-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .logo-badge {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: inline-block;
    background: rgba(188, 26, 34, 0.1);
    width: 64px;
    height: 64px;
    line-height: 64px;
    border-radius: 50%;
    text-align: center;
  }

  .login-card h2 {
    color: var(--secondary);
    margin-bottom: 0.5rem;
    font-size: 2rem;
  }

  .login-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-muted);
    font-size: 1.1rem;
    pointer-events: none;
  }

  input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.8rem;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.6);
    color: var(--text-main);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .toggle-password {
    position: absolute;
    right: 0.75rem;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.05rem;
    color: var(--text-muted);
    padding: 0.35rem;
    border-radius: 6px;
  }

  .toggle-password:hover {
    background: rgba(11, 19, 43, 0.06);
  }

  .auth-divider {
    position: relative;
    text-align: center;
    margin: 0.25rem 0;
  }

  .remember-row {
    margin-top: -0.35rem;
    margin-bottom: -0.35rem;
  }

  .remember-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .remember-label input {
    width: auto;
    accent-color: var(--primary);
  }

  .auth-divider::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--border-color);
  }

  .auth-divider span {
    position: relative;
    z-index: 1;
    background: white;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 0 0.5rem;
  }

  .btn-google {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: #fff;
    color: var(--text-main);
    font-weight: 700;
    font-family: var(--font-sans);
    padding: 0.75rem 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-google:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(11, 19, 43, 0.08);
  }

  .btn-google:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .google-icon {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 1px solid #dadce0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 800;
    color: #1a73e8;
    background: #fff;
  }

/* ...estilos ya definidos arriba... */

  /* Autofill Flash Animation */
  .highlight-flash {
    animation: flash 0.8s ease-out;
  }

  @keyframes flash {
    0% { background: rgba(188, 26, 34, 0.15); border-color: var(--primary); }
    100% { background: rgba(255, 255, 255, 0.6); }
  }

  /* Shake Error Animation */
  .shake-error {
    animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
  }

  @keyframes shake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
    40%, 60% { transform: translate3d(4px, 0, 0); }
  }

  /* Toast Notification Styling */
  .toast-container {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    pointer-events: none;
  }

  .toast {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    border-left: 5px solid #ccc;
    transform: translateX(120%);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s;
    opacity: 0;
    pointer-events: auto;
    max-width: 350px;
  }

  .toast.show {
    transform: translateX(0);
    opacity: 1;
  }

  .toast-success {
    border-left-color: #10b981;
  }

  .toast-error {
    border-left-color: var(--primary);
  }

  .toast-icon {
    font-size: 1.2rem;
  }

  .toast-message {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .login-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .login-card {
      padding: 2rem 1.5rem;
    }

    .demo-panel {
      padding: 1.5rem;
    }
  }
</style>
