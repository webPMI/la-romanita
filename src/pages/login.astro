---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar Sesión">
  <div class="container login-container animate-fade-in">
    <div class="login-card glass-panel">
      <h2>Bienvenido de nuevo</h2>
      <p>Inicia sesión para realizar pedidos o acceder a tu cuenta.</p>
      
      <form class="login-form">
        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input type="email" id="email" placeholder="tu@email.com" required />
        </div>
        
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input type="password" id="password" placeholder="••••••••" required />
        </div>
        
        <button type="submit" class="btn-primary full-width">Iniciar Sesión</button>
      </form>
      
      <div class="login-footer">
        <p>¿No tienes cuenta? <a href="#" class="highlight">Regístrate</a></p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .login-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    padding: 3rem 2rem;
    text-align: center;
  }

  .login-card h2 {
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .login-card p {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .login-form {
    text-align: left;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: rgba(0,0,0,0.2);
    color: var(--text-main);
    font-family: var(--font-sans);
  }

  input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .full-width {
    width: 100%;
    margin-top: 1rem;
  }

  .login-footer {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .highlight {
    color: var(--secondary);
    font-weight: 600;
  }
</style>
