---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "La Romanita - Pasta fresca artesanal y empanadas argentinas en Palma de Mallorca desde 1988." } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | La Romanita</title>
	</head>
	<body>
		<Navbar />
		<main class="main-content">
			<slot />
		</main>

		<!-- Botón flotante de WhatsApp -->
		<a href="https://wa.me/34643384775?text=Hola,%20me%20gustaría%20hacer%20un%20pedido%20en%20La%20Romanita" class="whatsapp-float" target="_blank" rel="noopener noreferrer">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
				<path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c-.003 1.396.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
			</svg>
		</a>

		<footer class="site-footer">
			<div class="container footer-content">
				<div class="footer-brand">
					<h3>La Romanita</h3>
					<p>Tradición y artesanía desde 1988.</p>
				</div>
				<div class="footer-links">
					<p>Carrer de Jaume Balmes, 59, Nord</p>
					<p>07004 Palma, Illes Balears</p>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} La Romanita. Todos los derechos reservados.</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-footer {
		background-color: var(--bg-surface);
		border-top: 1px solid var(--border-color);
		padding: 3rem 0 1rem 0;
		margin-top: 4rem;
	}
	.footer-content {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
		margin-bottom: 2rem;
	}
	.footer-brand h3 {
		color: var(--primary);
		margin-bottom: 0.5rem;
	}
	.footer-brand p, .footer-links p {
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	.footer-bottom {
		text-align: center;
		padding-top: 1rem;
		border-top: 1px solid rgba(11,19,43,0.1);
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	/* WhatsApp Floating Button */
	.whatsapp-float {
		position: fixed;
		width: 60px;
		height: 60px;
		bottom: 40px;
		right: 40px;
		background-color: #25d366;
		color: #FFF;
		border-radius: 50px;
		text-align: center;
		font-size: 30px;
		box-shadow: 0px 4px 10px rgba(0,0,0,0.2);
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.whatsapp-float:hover {
		transform: scale(1.1);
		box-shadow: 0px 6px 14px rgba(0,0,0,0.3);
		color: #FFF;
	}

	@media (max-width: 768px) {
		.whatsapp-float {
			bottom: 20px;
			right: 20px;
			width: 50px;
			height: 50px;
		}
		.whatsapp-float svg {
			width: 26px;
			height: 26px;
		}
	}
</style>
