---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Registro (Dev)">
  <div class="register-page-wrapper">
    <div class="glow glow-primary"></div>
    <div class="glow glow-secondary"></div>
    <div class="container register-container animate-fade-in">
      <div class="register-card glass-panel">
        <div class="register-header">
          <div class="logo-badge">🍝</div>
          <h2>Crea tu cuenta</h2>
          <p>Regístrate para realizar pedidos y guardar tu historial.</p>
        </div>
        <form class="register-form" id="registerForm" autocomplete="on">
          <div class="form-group">
            <label for="name">Nombre</label>
            <div class="input-wrapper">
              <span class="input-icon">👤</span>
              <input type="text" id="name" placeholder="Nombre" required autocomplete="given-name" />
            </div>
          </div>
          <div class="form-group">
            <label for="surname">Apellido</label>
            <div class="input-wrapper">
              <span class="input-icon">👤</span>
              <input type="text" id="surname" placeholder="Apellido" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <div class="input-wrapper">
              <span class="input-icon">✉️</span>
              <input type="email" id="email" placeholder="tu@email.com" required autocomplete="email" />
            </div>
          </div>
          <div class="form-group">
            <label for="phone">Teléfono</label>
            <div class="input-wrapper">
              <span class="input-icon">📱</span>
              <input type="tel" id="phone" placeholder="+34 600 000 000" required autocomplete="tel" />
            </div>
          </div>
          <div class="form-group">
            <label for="password">Contraseña</label>
            <div class="input-wrapper">
              <span class="input-icon">🔒</span>
              <input type="password" id="password" placeholder="Mínimo 6 caracteres" required minlength="6" autocomplete="new-password" />
              <button type="button" id="togglePassword" tabindex="-1" style="position:absolute;right:1rem;background:none;border:none;cursor:pointer;">👁️</button>
            </div>
          </div>
          <div class="form-group">
            <label for="confirmPassword">Confirmar Contraseña</label>
            <div class="input-wrapper">
              <span class="input-icon">🔒</span>
              <input type="password" id="confirmPassword" placeholder="Repite tu contraseña" required minlength="6" autocomplete="new-password" />
              <button type="button" id="toggleConfirmPassword" tabindex="-1" style="position:absolute;right:1rem;background:none;border:none;cursor:pointer;">👁️</button>
            </div>
          </div>
          <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;">
            <input type="checkbox" id="acceptPolicies" required style="width:auto;" />
            <label for="acceptPolicies" style="margin:0;">Acepto las <a href="/politicas" target="_blank">políticas de privacidad</a></label>
          </div>
          <button type="submit" class="btn-primary full-width" id="submitBtn">
            <span class="btn-text">Registrarse</span>
            <span class="spinner hide"></span>
          </button>
          <button type="button" id="autofillBtn" style="margin-top:0.5rem;width:100%;background:#eee;color:#333;border-radius:8px;border:none;padding:0.5rem 0;">Autocompletar (dev)</button>
        </form>
        <div class="register-footer">
          <p>¿Ya tienes cuenta? <a href="/login" class="highlight">Inicia Sesión</a></p>
        </div>
      </div>
    </div>
  </div>
  <div id="toastContainer" class="toast-container"></div>
</Layout>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nameInput = document.getElementById('name');
    const surnameInput = document.getElementById('surname');
    const emailInput = document.getElementById('email');
    const phoneInput = document.getElementById('phone');
    const passwordInput = document.getElementById('password');
    const confirmPasswordInput = document.getElementById('confirmPassword');
    const acceptPolicies = document.getElementById('acceptPolicies');
    const submitBtn = document.getElementById('submitBtn');
    const autofillBtn = document.getElementById('autofillBtn');
    const btnText = submitBtn.querySelector('.btn-text');
    const spinner = submitBtn.querySelector('.spinner');
    const registerCard = document.querySelector('.register-card');
    const toastContainer = document.getElementById('toastContainer');
    const base = window.location.pathname.startsWith('/la-romanita') ? '/la-romanita' : '';
    document.getElementById('togglePassword').addEventListener('click', () => {
      passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
    });
    document.getElementById('toggleConfirmPassword').addEventListener('click', () => {
      confirmPasswordInput.type = confirmPasswordInput.type === 'password' ? 'text' : 'password';
    });
    autofillBtn.addEventListener('click', () => {
      nameInput.value = 'Juan';
      surnameInput.value = 'Pérez';
      emailInput.value = `cliente${Math.floor(Math.random()*10000)}@ejemplo.com`;
      phoneInput.value = '+34 600 000 000';
      passwordInput.value = '123456';
      confirmPasswordInput.value = '123456';
      acceptPolicies.checked = true;
    });
    registerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = nameInput.value.trim();
      const surname = surnameInput.value.trim();
      const email = emailInput.value.trim();
      const phone = phoneInput.value.trim();
      const password = passwordInput.value;
      const confirmPassword = confirmPasswordInput.value;
      const accepted = acceptPolicies.checked;
      if (!accepted) {
        showToast('Debes aceptar las políticas de privacidad.', 'error');
        registerCard?.classList.add('shake-error');
        setTimeout(() => registerCard?.classList.remove('shake-error'), 500);
        return;
      }
      if (password !== confirmPassword) {
        showToast('Las contraseñas no coinciden.', 'error');
        registerCard?.classList.add('shake-error');
        setTimeout(() => registerCard?.classList.remove('shake-error'), 500);
        return;
      }
      if (password.length < 6) {
        showToast('La contraseña debe tener al menos 6 caracteres.', 'error');
        registerCard?.classList.add('shake-error');
        setTimeout(() => registerCard?.classList.remove('shake-error'), 500);
        return;
      }
      submitBtn.disabled = true;
      nameInput.disabled = true;
      surnameInput.disabled = true;
      emailInput.disabled = true;
      phoneInput.disabled = true;
      passwordInput.disabled = true;
      confirmPasswordInput.disabled = true;
      acceptPolicies.disabled = true;
      btnText?.classList.add('hide');
      spinner?.classList.remove('hide');
      try {
        const response = await fetch(`${base}/api/auth/register`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            name,
            surname,
            email,
            phone,
            password
          })
        });
        const data = await response.json();
        if (data.success) {
          showToast('Cuenta creada con éxito. Redirigiendo...', 'success');
          setTimeout(() => {
            window.location.href = `${base}/login`;
          }, 1500);
        } else {
          showToast(data.error || 'Ocurrió un error al procesar el registro.', 'error');
          resetFormState();
        }
      } catch (err) {
        console.error('Error durante el registro:', err);
        showToast('Error de conexión con el servidor.', 'error');
        resetFormState();
      }
    });
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.innerHTML = `
        <span class="toast-icon">${type === 'success' ? '✅' : '❌'}</span>
        <span class="toast-message">${message}</span>
      `;
      toastContainer?.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.add('show');
      });
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }
    function resetFormState() {
      submitBtn.disabled = false;
      nameInput.disabled = false;
      surnameInput.disabled = false;
      emailInput.disabled = false;
      phoneInput.disabled = false;
      passwordInput.disabled = false;
      confirmPasswordInput.disabled = false;
      acceptPolicies.disabled = false;
      btnText?.classList.remove('hide');
      spinner?.classList.add('hide');
      registerCard?.classList.add('shake-error');
      setTimeout(() => registerCard?.classList.remove('shake-error'), 500);
    }
  });
</script>
