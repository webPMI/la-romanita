---
import Layout from '../layouts/Layout.astro';
import { demoUsers } from './mockData.js';
const base = import.meta.env.BASE_URL;
---

<Layout title="Iniciar Sesión (Dev)">
  <div class="login-page-wrapper">
    <!-- Abstract background glow elements -->
    <div class="glow glow-primary"></div>
    <div class="glow glow-secondary"></div>

    <div class="container login-container animate-fade-in">
      <div class="login-card glass-panel">
        <div class="login-header">
          <div class="logo-badge">🍝</div>
          <h2>Bienvenido de nuevo</h2>
          <p>Inicia sesión para realizar pedidos o acceder a tu cuenta.</p>
        </div>
        
        <form class="login-form" id="loginForm">
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <div class="input-wrapper">
              <span class="input-icon">✉️</span>
              <input type="email" id="email" placeholder="tu@email.com" required />
            </div>
          </div>
          
          <div class="form-group">
            <label for="password">Contraseña</label>
            <div class="input-wrapper">
              <span class="input-icon">🔒</span>
              <input type="password" id="password" placeholder="••••••••" required />
            </div>
          </div>
          
          <button type="submit" class="btn-primary full-width" id="submitBtn">
            <span class="btn-text">Iniciar Sesión</span>
            <span class="spinner hide"></span>
          </button>
        </form>
        
        <div class="login-footer">
          <p>¿No tienes cuenta? <a href={`${base}register`} class="highlight">Regístrate</a></p>
        </div>
      </div>

      <!-- Demo Credentials Panel -->
      <div class="demo-panel glass-panel">
        <h3>🔑 Acceso Rápido (Modo Demo)</h3>
        <p>Haz clic en cualquiera de las credenciales de prueba para rellenar el formulario e iniciar sesión automáticamente:</p>
        
        <div class="demo-cards">
          {demoUsers.map((user) => (
            <div class="demo-card" data-email={user.email} data-password={user.password} title="Hacer clic para rellenar">
              <div class="demo-card-header">
                <span class={`role-badge ${user.role}`}>
                  {user.role === 'admin' ? '👑 Administrador' : '👤 Cliente'}
                </span>
                <span class="click-action">Autocompletar ⚡</span>
              </div>
              <div class="demo-card-body">
                <p><strong>Email:</strong> <code>{user.email}</code></p>
                <p><strong>Clave:</strong> <code>{user.password}</code></p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container"></div>
</Layout>

<!-- Client-side login verification and autofill script -->
<script define:vars={{ demoUsers }}>
  document.addEventListener('DOMContentLoaded', () => {
    const loginForm = document.getElementById('loginForm');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = submitBtn.querySelector('.btn-text');
    const spinner = submitBtn.querySelector('.spinner');
    const demoCards = document.querySelectorAll('.demo-card');
    const loginCard = document.querySelector('.login-card');
    const toastContainer = document.getElementById('toastContainer');

    // Dynamic base path determination
    const base = window.location.pathname.startsWith('/la-romanita') ? '/la-romanita' : '';

    // Handle toast alerts
    function showToast(message, type = 'success') {
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.innerHTML = `
        <span class="toast-icon">${type === 'success' ? '✅' : '❌'}</span>
        <span class="toast-message">${message}</span>
      `;
      toastContainer.appendChild(toast);

      // Trigger animation frame for transition
      requestAnimationFrame(() => {
        toast.classList.add('show');
      });

      // Remove toast after duration
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // Handle quick credential fill
    demoCards.forEach(card => {
      card.addEventListener('click', () => {
        const email = card.getAttribute('data-email');
        const password = card.getAttribute('data-password');

        emailInput.value = email;
        passwordInput.value = password;

        // Visual flash feedback on inputs
        [emailInput, passwordInput].forEach(input => {
          input.classList.add('highlight-flash');
          setTimeout(() => input.classList.remove('highlight-flash'), 800);
        });

        showToast('Credenciales autocompletadas. ¡Pulsa Iniciar Sesión!', 'success');
      });
    });

    // Form submit simulator
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      // Loading state
      submitBtn.disabled = true;
      emailInput.disabled = true;
      passwordInput.disabled = true;
      btnText.classList.add('hide');
      spinner.classList.remove('hide');

      // Realizar petición real de inicio de sesión a la API del servidor
      fetch(`${base}/api/auth/login`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ email, password })
      })
      .then(res => res.json())
      .then(data => {
        if (data.success && data.user) {
          // Éxito
          showToast('¡Bienvenido! Redirigiendo...', 'success');
          setTimeout(() => {
            window.location.href = `${base}/`;
          }, 1200);
        } else {
          showToast(data.error || 'Error al iniciar sesión.', 'error');
          resetFormState();
        }
      })
      .catch(() => {
        showToast('Error de conexión con el servidor.', 'error');
        resetFormState();
      });

      function resetFormState() {
        submitBtn.disabled = false;
        emailInput.disabled = false;
        passwordInput.disabled = false;
        btnText.classList.remove('hide');
        spinner.classList.add('hide');
        loginCard.classList.add('shake-error');
        setTimeout(() => loginCard.classList.remove('shake-error'), 500);
      }
    });
  });
</script>
